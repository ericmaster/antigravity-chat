# Server Port
PORT=3121

# Path to agy binary
AGY_BIN=agy

# agy timeout per turn in seconds
AGY_TIMEOUT=300

# Enable sandbox mode for agy (0 or 1)
AGY_SANDBOX=0

# Output format for agy (stream-json or text)
AGY_OUTPUT_FORMAT=stream-json

# Optionally exclude named MCP servers from web chat subprocesses
AGY_DISABLE_MCP=false
AGY_DISABLED_MCP_SERVERS=

# Set true to disable every MCP server
# AGY_DISABLE_MCP=true

# Ephemeral HOME used for filtered agy MCP config
# AGY_RUNTIME_HOME=./scratch/.agy-home

# Enable conversation persistence across turns and sessions
AGY_PERSIST_CONVERSATIONS=true

# Storage file for user conversation mappings
# AGY_CONVERSATIONS_FILE=.antigravity_conversations.json

# Infisical project configuration (used by start.sh)
# INFISICAL_PROJECT_ID=your-infisical-project-id
# INFISICAL_ENV=dev
# INFISICAL_HOST_URL=http://localhost:3080

# Scratch working directory (fallback when no workspace folder is selected)
# AGY_SCRATCH=./scratch

# Jailed workspace allowed roots (colon-separated)
# AGY_ALLOWED_ROOTS=

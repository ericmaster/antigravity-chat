# Server Port
PORT=3121

# Path to agy binary
AGY_BIN=agy

# agy timeout per turn in seconds
AGY_TIMEOUT=300

# Enable sandbox mode for agy (0 or 1)
AGY_SANDBOX=0

# Infisical project configuration (used by start.sh)
# INFISICAL_PROJECT_ID=your-infisical-project-id
# INFISICAL_ENV=dev
# INFISICAL_HOST_URL=http://localhost:3080

# Scratch working directory (fallback when no workspace folder is selected)
# AGY_SCRATCH=/home/<username>/antigravity-chat/scratch

# Jailed workspace allowed roots (colon-separated)
# AGY_ALLOWED_ROOTS=
